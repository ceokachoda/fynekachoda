{
  "name": "fynestudy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "dev:mobile": "pnpm --filter @fynestudy/mobile dev",
    "dev:admin": "pnpm --filter @fynestudy/admin dev",
    "fn:deploy": "supabase functions deploy --project-ref $SUPABASE_PROJECT_REF",
    "db:diff": "supabase db diff --linked",
    "db:push": "supabase db push --linked",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "smoke:cp5": "tsx scripts/smoke-test-cp5.ts",
    "smoke:cp8": "tsx scripts/smoke-test-cp8.ts",
    "smoke:batch-transfer": "tsx scripts/smoke-test-batch-transfer.ts",
    "smoke:curriculum": "tsx scripts/smoke-test-curriculum.ts",
    "smoke:batch-mutate": "tsx scripts/smoke-test-batch-mutate.ts",
    "smoke:mfa-recovery": "tsx scripts/smoke-test-mfa-recovery.ts",
    "test:rls": "tsx scripts/test-rls.ts",
    "test:hmac": "tsx scripts/test-hmac.ts",
    "smoke:qr-sign": "tsx scripts/smoke-test-attendance-qr-sign.ts",
    "smoke:qr-verify": "tsx scripts/smoke-test-attendance-qr-verify.ts",
    "smoke:cp6": "tsx scripts/smoke-test-cp6.ts",
    "smoke:materialize": "tsx scripts/smoke-test-materialize-sessions.ts",
    "smoke:realtime": "tsx scripts/smoke-test-realtime-attendance.ts",
    "smoke:manual-mark": "tsx scripts/smoke-test-attendance-manual-mark.ts",
    "seed:manual-test": "tsx scripts/seed-manual-test.ts",
    "test:content": "tsx scripts/test-content-helpers.ts",
    "smoke:content-rls": "tsx scripts/smoke-test-content-rls.ts",
    "smoke:content-fns": "tsx scripts/smoke-test-content-edge-fns.ts",
    "seed:content-manual-test": "tsx scripts/seed-content-manual-test.ts",
    "test:quiz": "tsx scripts/test-quiz-helpers.ts",
    "smoke:quiz-rls": "tsx scripts/smoke-test-quiz-rls.ts",
    "smoke:quiz-fns": "tsx scripts/smoke-test-quiz-edge-fns.ts",
    "seed:quiz-manual-test": "tsx scripts/seed-quiz-manual-test.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-css-interop@0.2.3": "patches/react-native-css-interop@0.2.3.patch"
    }
  }
}
